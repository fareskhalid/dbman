#!/usr/bin/env php
<?php
declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit;
}

$autoload = $_composer_autoload_path ?? dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Missing Composer dependencies. Run composer install first.\n");
    exit(1);
}

require $autoload;

exit((new \Fares\Dbman\Application())->run(array_slice($argv, 1)));
